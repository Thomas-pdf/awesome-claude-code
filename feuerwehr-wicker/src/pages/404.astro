---
import Base from '../layouts/Base.astro';
---
<Base title="Seite nicht gefunden" noindex>
  <section class="container--schmal section" style="text-align:center">
    <p class="eyebrow" style="justify-content:center">Fehler 404</p>
    <h1>Diese Seite gibt es (nicht mehr)</h1>
    <p>Vielleicht wurde sie beim Umzug auf die neue Website verschoben. Versuchen Sie es mit der Suche oder starten Sie auf der Startseite.</p>
    <p style="display:flex;gap:.8rem;justify-content:center;flex-wrap:wrap;margin-top:2rem"><a class="btn btn--rot" href="/">Zur Startseite</a><a class="btn btn--rand" href="/suche">Zur Suche</a></p>
    <p style="margin-top:3rem" class="hinweis">Im Notfall wählen Sie bitte immer die <a href="tel:112"><strong>112</strong></a>.</p>
  </section>
</Base>
<script>
  // Alte Links (index_main.php?page=123, einsaetze.php?enr=456) auf neue Adressen umleiten – funktioniert bei jedem Hoster
  const q = new URLSearchParams(location.search);
  if (q.has('page') || q.has('enr') || /\.php$/.test(location.pathname)) {
    fetch('/weiterleitungen.json').then((r) => r.json()).then((m) => {
      const ziel = (q.get('enr') && m.einsaetze[q.get('enr')]) || (q.get('page') && m.seiten[q.get('page')])
        || (/einsaetze\.php/.test(location.pathname) ? '/einsaetze' : /termine\.php/.test(location.pathname) ? '/termine' : '/');
      location.replace(ziel);
    }).catch(() => {});
  }
</script>
