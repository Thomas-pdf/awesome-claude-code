---
import Base from '../../layouts/Base.astro';
---
<Base title="Mitgliederbereich (Demo)" noindex>
  <section class="login-seite">
    <div class="login-karte">
      <p class="demo-band">DEMO · Prototyp · keine echten Daten</p>
      <img class="login-logo" src="/logo-feuerwehren-floersheim.webp" alt="Feuerwehren Stadt Flörsheim am Main" width="260" height="50" />
      <h1>Mitgliederbereich</h1>
      <p class="login-text">Für aktive Mitglieder: Dienste &amp; Lehrgänge, eigene Tauglichkeiten, Verteiler und Dokumente.</p>
      <form class="login-form" action="/intern/bereich" method="get" data-login>
        <label for="benutzer">Benutzername oder E-Mail</label>
        <input id="benutzer" name="benutzer" autocomplete="username" value="alex.muster" />
        <label for="passwort">Passwort</label>
        <input id="passwort" name="passwort" type="password" autocomplete="current-password" value="demo" />
        <button class="btn btn--rot" type="submit">Anmelden (Demo)</button>
        <p class="login-klein">Im Echtbetrieb: Anmeldung mit persönlichem Konto, Zwei-Faktor-Code per App und Passwort-Zurücksetzen per E-Mail.</p>
      </form>
      <p class="hinweis hinweis--demo">Diese Seite ist eine <strong>Vorschau</strong>, wie der Mitgliederbereich künftig aussehen könnte. Jede Eingabe führt in den Demo-Bereich mit erfundenen Beispieldaten. Es werden keine Daten übertragen oder gespeichert.</p>
    </div>
  </section>
</Base>
<script>
  // Demo: Passwort nicht in die URL schreiben
  document.querySelector('[data-login]')?.addEventListener('submit', (e) => {
    e.preventDefault();
    window.location.href = '/intern/bereich';
  });
</script>
<style>
  .login-seite { min-height: 70vh; display: grid; place-items: center; padding: 3rem 1rem; background: var(--flaeche); }
  .login-karte { background: #fff; border-radius: 28px; padding: 2.2rem; width: min(100%, 440px); box-shadow: var(--schatten-hover); text-align: center; position: relative; overflow: hidden; }
  .demo-band { margin: -2.2rem -2.2rem 1.6rem; background: #fff6e0; color: #6b4a00; font-weight: 600; letter-spacing: .02em; font-size: .8rem; padding: .5rem; }
  .login-logo { margin: 0 auto 1.2rem; width: 260px; height: auto; }
  .login-text { color: var(--text-2); }
  .login-form { display: grid; gap: .4rem; text-align: left; margin: 1.5rem 0; }
  .login-form label { font-weight: 700; font-size: .92rem; margin-top: .5rem; }
  .login-form input { font: inherit; padding: .8rem 1rem; border: 1px solid var(--linie); border-radius: 12px; }
  .login-form input:focus { border-color: var(--rot); outline: none; box-shadow: 0 0 0 3px var(--rot-hell); }
  .login-form .btn { justify-content: center; margin-top: 1rem; padding: .95rem; }
  .login-klein { font-size: .83rem; color: var(--text-2); margin-top: .6rem; }
  .hinweis--demo { text-align: left; font-size: .9rem; }
</style>
