---
import Base from '../layouts/Base.astro';
import BerichtKarte from '../components/BerichtKarte.astro';
import TerminListe from '../components/TerminListe.astro';
import { berichte, einsaetze, kommendeTermine, einsatzJahr, einsatzUrl, heute, datum, artKlasse } from '../lib/inhalte';
import { SITE, UEBUNGSZEITEN } from '../lib/site';

const alleBerichte = await berichte();
const [aufmacher, ...weitere] = alleBerichte.slice(0, 6);
const alleEinsaetze = await einsaetze();
const naechste = await kommendeTermine(4);
const neubau = alleBerichte.find((b) => b.data.bereich === 'neubau');

// Einsatzgeschehen monatsbezogen (wie auf den Seiten vieler Feuerwehren üblich)
const MONATE = ['Januar', 'Februar', 'März', 'April', 'Mai', 'Juni', 'Juli', 'August', 'September', 'Oktober', 'November', 'Dezember'];
const h = heute();
const jahr = h.getUTCFullYear();
const monat = h.getUTCMonth();
const imMonat = (j: number, m: number) => alleEinsaetze.filter((e) => e.data.datum.getUTCFullYear() === j && e.data.datum.getUTCMonth() === m);
const dieserMonat = imMonat(jahr, monat);
const vorMonatJ = monat === 0 ? jahr - 1 : jahr;
const vorMonatM = (monat + 11) % 12;
const letzterMonat = imMonat(vorMonatJ, vorMonatM);
const diesesJahr = alleEinsaetze.filter((e) => einsatzJahr(e) === jahr);
const zaehle = (l: typeof alleEinsaetze, art: string) => l.filter((e) => e.data.art === art).length;
// Letzte 12 Monate für das Balkendiagramm
const verlauf = Array.from({ length: 12 }, (_, i) => {
  const m = (monat - 11 + i + 24) % 12;
  const j = monat - 11 + i < 0 ? jahr - 1 : jahr;
  return { label: MONATE[m].slice(0, 3), n: imMonat(j, m).length, aktuell: i === 11 };
});
const maxV = Math.max(1, ...verlauf.map((v) => v.n));
// Liste: Einsätze dieses Monats, bei wenigen ergänzt um die letzten
const liste = (dieserMonat.length >= 4 ? dieserMonat : alleEinsaetze).slice(0, 5);
---
<Base>
  <section class="hero">
    <div class="container hero__text reveal">
      <p class="eyebrow">Freiwillige Feuerwehr Flörsheim-Wicker</p>
      <h1>Für Wicker da.<br />Rund um die Uhr.</h1>
      <p class="hero__unter">Ehrenamtlich seit {SITE.gegruendet}. Wir löschen, retten, bergen und schützen, in Wicker, in Flörsheim und im ganzen Main-Taunus-Kreis.</p>
      <div class="hero__aktionen">
        <a class="btn btn--rot" href="/mitmachen">Mitmachen</a>
        <a class="link-pfeil" href="/einsaetze">Aktuelle Einsätze</a>
      </div>
    </div>
    <div class="container hero__bilder reveal">
      <img src="/bilder/archiv/6346_20261002111151_299036.webp" alt="Drei Generationen Löschfahrzeuge der Feuerwehr Wicker: LF 8/6, StLF 20V und LF 10" width="640" height="480" fetchpriority="high" />
      <img class="hero__bild-mitte" src="/bilder/archiv/5212_20240512173811_401608.webp" alt="Gruppenfoto der Einsatzabteilung vor dem Feuerwehrhaus Wicker, Mai 2024" width="720" height="420" fetchpriority="high" />
      <img src="/bilder/archiv/5941_20260221173618_800932.webp" alt="Spatenstich für das neue Feuerwehrhaus im Prälat-Müller-Weg" width="640" height="480" />
    </div>
  </section>

  <section class="section section--grau einsatzlage" aria-labelledby="einsatz-titel">
    <div class="container">
      <div class="section-head section-head--mitte reveal">
        <p class="eyebrow">Einsatzgeschehen</p>
        <h2 id="einsatz-titel">{MONATE[monat]} {jahr}: {dieserMonat.length} {dieserMonat.length === 1 ? 'Einsatz' : 'Einsätze'}</h2>
        <p>Jeder Alarm wird von ehrenamtlichen Kräften abgearbeitet, zu jeder Tages- und Nachtzeit.</p>
      </div>
      <div class="einsatz-kacheln reveal">
        <div class="kachel kachel--gross">
          <p class="kachel__label">Diesen Monat</p>
          <p class="kachel__zahl">{dieserMonat.length}</p>
          <p class="kachel__aufteilung">
            <span><i class="punkt punkt--brand"></i>{zaehle(dieserMonat, 'Brand')} Brand</span>
            <span><i class="punkt punkt--hilfe"></i>{zaehle(dieserMonat, 'Hilfeleistung')} Technische Hilfe</span>
            {zaehle(dieserMonat, 'Sonstiges') > 0 && <span><i class="punkt"></i>{zaehle(dieserMonat, 'Sonstiges')} Sonstige</span>}
          </p>
        </div>
        <div class="kachel">
          <p class="kachel__label">{MONATE[vorMonatM]}</p>
          <p class="kachel__zahl">{letzterMonat.length}</p>
          <p class="kachel__klein">Einsätze im Vormonat</p>
        </div>
        <div class="kachel">
          <p class="kachel__label">{jahr} bisher</p>
          <p class="kachel__zahl">{diesesJahr.length}</p>
          <p class="kachel__klein"><a class="link-pfeil" href={`/einsaetze/${jahr}`}>Jahresstatistik</a></p>
        </div>
        <div class="kachel kachel--verlauf">
          <p class="kachel__label">Letzte 12 Monate</p>
          <div class="verlauf" role="img" aria-label={verlauf.map((v) => `${v.label}: ${v.n}`).join(', ')}>
            {verlauf.map((v) => (
              <span class:list={['verlauf__spalte', { aktuell: v.aktuell }]}>
                <span class="verlauf__wert">{v.n}</span>
                <span class="verlauf__balken" style={`height:${Math.max(4, (v.n / maxV) * 100)}%`}></span>
                <span class="verlauf__monat">{v.label}</span>
              </span>
            ))}
          </div>
        </div>
      </div>

      <div class="einsatz-liste reveal">
        <div class="einsatz-liste__kopf">
          <h3>{dieserMonat.length >= 4 ? `Einsätze im ${MONATE[monat]}` : 'Letzte Einsätze'}</h3>
          <a class="link-pfeil" href="/einsaetze">Alle Einsätze</a>
        </div>
        <ol>
          {liste.map((e) => (
            <li>
              <a href={einsatzUrl(e)} class={`einsatz-zeile einsatz-zeile--${artKlasse(e.data.art)}`}>
                <span class="einsatz-zeile__datum">{datum(e.data.datum)}{e.data.uhrzeit && <small>{e.data.uhrzeit} Uhr</small>}</span>
                <span class="einsatz-zeile__haupt">
                  <strong>{e.data.stichwort}</strong>
                  <span>{e.data.einsatzort}{e.body?.trim() && ` · ${e.body.trim().replace(/[*_#>\\\[\]()!]/g, '').slice(0, 110)}…`}</span>
                </span>
                <span class="einsatz-zeile__mehr" aria-hidden="true">Bericht ›</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <div><p class="eyebrow">Aktuelles</p><h2>Neues aus Wicker.</h2></div>
        <a class="link-pfeil" href="/aktuelles">Alle Berichte</a>
      </div>
      <div class="bento reveal">
        {aufmacher && <div class="bento__gross"><BerichtKarte b={aufmacher} gross /></div>}
        {weitere.map((b) => <BerichtKarte b={b} />)}
      </div>
    </div>
  </section>

  <section class="section section--grau">
    <div class="container neubau">
      <div class="neubau__text reveal">
        <p class="eyebrow">Neubau Feuerwehrhaus</p>
        <h2>Ein neues Zuhause.<br />Für 2027.</h2>
        <p class="neubau__unter">Im Prälat-Müller-Weg entsteht unser neues Feuerwehrhaus: mehr Platz für Fahrzeuge, moderne Hygiene- und Schulungsbereiche und ein eigener Raum für Jugend- und Kinderfeuerwehr.</p>
        <ol class="zeitstrahl">
          <li class="erledigt"><strong>04/2025</strong>Baugenehmigung</li>
          <li class="erledigt"><strong>02/2026</strong>Spatenstich</li>
          <li class="erledigt"><strong>2026</strong>Richtfest</li>
          <li><strong>2027</strong>Einzug</li>
        </ol>
        <div class="hero__aktionen hero__aktionen--links">
          <a class="btn btn--rot" href="/neubau">Alles zum Neubau</a>
          {neubau && <a class="link-pfeil" href={`/aktuelles/${neubau.id}`}>Bautagebuch {neubau.data.title.replace('Bautagebuch ', '')}</a>}
        </div>
      </div>
      <div class="neubau__bild reveal">
        <img src="/bilder/archiv/5941_20260221173618_800932.webp" alt="Spatenstich für das neue Feuerwehrhaus Wicker im Februar 2026" loading="lazy" width="640" height="480" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head section-head--mitte reveal">
        <p class="eyebrow">Mitmachen</p>
        <h2>Für jedes Alter die richtige Gruppe.</h2>
        <p>Feuerwehr ist Teamarbeit. Wir bilden dich aus, vom Minilöscher bis zur Einsatzkraft.</p>
      </div>
      <div class="gruppen reveal">
        {UEBUNGSZEITEN.map((u) => (
          <a class="gruppe" href={u.link}>
            <h3>{u.gruppe}</h3>
            {u.alter && <p class="gruppe__alter">{u.alter}</p>}
            <p>{u.zeit}</p>
            <span class="link-pfeil">Mehr erfahren</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--grau">
    <div class="container zwei">
      <div class="reveal">
        <div class="section-head"><div><p class="eyebrow">Termine</p><h2>Demnächst.</h2></div><a class="link-pfeil" href="/termine">Kalender</a></div>
        {naechste.length ? <TerminListe liste={naechste} /> : <p>Aktuell sind keine Termine eingetragen.</p>}
      </div>
      <div class="reveal">
        <div class="section-head"><div><p class="eyebrow">Bürgerinfo</p><h2>Gut vorbereitet.</h2></div></div>
        <div class="info-liste">
          <a href="/buergerinfo/verhalten-im-notfall"><strong>Richtig Notruf absetzen</strong><span>Wo? Was? Wie viele? Welche Verletzungen? Warten auf Rückfragen.</span></a>
          <a href="/buergerinfo/brandschutz/rauchmelder"><strong>Rauchmelder</strong><span>Sie retten Leben, auch nachts, wenn Sie schlafen.</span></a>
          <a href="/buergerinfo/brandschutz"><strong>Brandschutz-Tipps</strong><span>Grillen, Silvester, Advent, Heizen und mehr.</span></a>
          <a href="/100-jahre"><strong>100 Jahre Feuerwehr Wicker</strong><span>1925 bis 2025: unser Jubiläumsjahr im Rückblick.</span></a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: clamp(3rem, 7vw, 5.5rem) clamp(2.5rem, 5vw, 4rem); text-align: center; }
  .hero__text .eyebrow { color: var(--rot); }
  .hero h1 { font-size: clamp(2.9rem, 8vw, 5.6rem); line-height: 1.02; letter-spacing: -.04em; margin: .2rem 0 1rem; }
  .hero__unter { font-size: clamp(1.15rem, 2vw, 1.45rem); color: var(--text-2); max-width: 40ch; margin: 0 auto; line-height: 1.4; letter-spacing: -.015em; }
  .hero__aktionen { display: flex; gap: 1.4rem; justify-content: center; align-items: center; flex-wrap: wrap; margin-top: 1.8rem; }
  .hero__aktionen--links { justify-content: flex-start; }
  .hero__bilder { display: grid; grid-template-columns: 1fr 1.25fr 1fr; gap: 1rem; margin-top: clamp(2.5rem, 5vw, 4rem); align-items: end; }
  .hero__bilder img { width: 100%; aspect-ratio: 4 / 3.4; object-fit: cover; border-radius: var(--radius); }
  .hero__bilder .hero__bild-mitte { aspect-ratio: 4 / 3; }
  @media (max-width: 760px) { .hero__bilder { grid-template-columns: 1fr 1fr; } .hero__bild-mitte { grid-column: 1 / -1; order: -1; } }

  .einsatz-kacheln { display: grid; gap: 1rem; grid-template-columns: repeat(4, 1fr); }
  .kachel { background: var(--weiss); border-radius: var(--radius); padding: 1.5rem 1.6rem; display: flex; flex-direction: column; gap: .2rem; min-width: 0; }
  .kachel p { margin: 0; }
  .kachel__label { font-weight: 600; color: var(--text-2); font-size: .95rem; }
  .kachel__zahl { font-size: clamp(3rem, 6vw, 4.5rem); font-weight: 700; letter-spacing: -.05em; line-height: 1; font-variant-numeric: tabular-nums; margin: .3rem 0 .4rem !important; }
  .kachel--gross .kachel__zahl { color: var(--rot); }
  .kachel__klein { color: var(--text-2); font-size: .92rem; margin-top: auto !important; }
  .kachel__aufteilung { display: flex; flex-direction: column; gap: .15rem; font-size: .92rem; color: var(--text-2); }
  .punkt { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--text-3); margin-right: .45rem; }
  .punkt--brand { background: var(--rot); }
  .punkt--hilfe { background: var(--blau); }
  .verlauf { display: grid; grid-template-columns: repeat(12, 1fr); gap: 4px; height: 130px; align-items: end; margin-top: .6rem; }
  .verlauf__spalte { display: flex; flex-direction: column; align-items: center; justify-content: flex-end; height: 100%; gap: 3px; }
  .verlauf__balken { width: 100%; background: var(--linie); border-radius: 4px; }
  .verlauf__spalte.aktuell .verlauf__balken { background: var(--rot); }
  .verlauf__wert { font-size: .68rem; color: var(--text-2); font-variant-numeric: tabular-nums; }
  .verlauf__monat { font-size: .64rem; color: var(--text-3); }
  @media (max-width: 980px) { .einsatz-kacheln { grid-template-columns: repeat(3, 1fr); } .kachel--verlauf { grid-column: 1 / -1; } }
  @media (max-width: 600px) { .einsatz-kacheln { grid-template-columns: 1fr 1fr; } .kachel--gross { grid-column: 1 / -1; } .kachel:nth-child(3) { grid-column: auto; } }

  .einsatz-liste { margin-top: 1rem; background: var(--weiss); border-radius: var(--radius); padding: 1.4rem 1.6rem .6rem; }
  .einsatz-liste__kopf { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin-bottom: .4rem; }
  .einsatz-liste__kopf h3 { margin: 0; }
  .einsatz-liste ol { list-style: none; margin: 0; padding: 0; }
  .einsatz-liste li + li { border-top: 1px solid var(--linie-hell); }
  .einsatz-zeile { display: grid; grid-template-columns: 110px 1fr auto; gap: 1.2rem; align-items: center; padding: 1rem 0; color: var(--text); }
  .einsatz-zeile:hover { text-decoration: none; }
  .einsatz-zeile:hover strong { color: var(--rot); }
  .einsatz-zeile__datum { font-weight: 600; font-variant-numeric: tabular-nums; font-size: .95rem; display: flex; flex-direction: column; }
  .einsatz-zeile__datum small { font-weight: 400; color: var(--text-2); font-size: .82rem; }
  .einsatz-zeile__haupt { min-width: 0; display: flex; flex-direction: column; gap: .15rem; }
  .einsatz-zeile__haupt strong { font-weight: 600; }
  .einsatz-zeile__haupt strong::before { content: ''; display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--text-3); margin-right: .55rem; vertical-align: .1em; }
  .einsatz-zeile--brand strong::before { background: var(--rot); }
  .einsatz-zeile--hilfe strong::before { background: var(--blau); }
  .einsatz-zeile__haupt span { color: var(--text-2); font-size: .92rem; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
  .einsatz-zeile__mehr { color: var(--rot); font-weight: 500; white-space: nowrap; }
  @media (max-width: 640px) { .einsatz-zeile { grid-template-columns: 1fr; gap: .3rem; } .einsatz-zeile__datum { flex-direction: row; gap: .5rem; } .einsatz-zeile__mehr { display: none; } }

  .bento { display: grid; gap: 1.25rem; grid-template-columns: repeat(3, 1fr); }
  .bento__gross { grid-column: span 2; grid-row: span 2; display: flex; }
  .bento__gross > :global(.karte) { flex: 1; }
  .bento__gross :global(.karte__bild) { aspect-ratio: auto; flex: 1; min-height: 260px; }
  @media (max-width: 900px) { .bento { grid-template-columns: 1fr 1fr; } .bento__gross { grid-column: 1 / -1; grid-row: auto; } }
  @media (max-width: 560px) { .bento { grid-template-columns: 1fr; } }

  .neubau { display: grid; gap: clamp(2rem, 5vw, 4rem); align-items: center; grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr)); }
  .neubau__unter { color: var(--text-2); font-size: 1.15rem; }
  .neubau__bild img { border-radius: var(--radius); width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .zeitstrahl { list-style: none; padding: 0; margin: 1.8rem 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: .3rem; }
  .zeitstrahl li { position: relative; padding-top: 1.5rem; font-size: .88rem; color: var(--text-2); }
  .zeitstrahl li::before { content: ''; position: absolute; top: .38rem; left: 0; right: 0; height: 3px; background: var(--linie); border-radius: 2px; }
  .zeitstrahl li::after { content: ''; position: absolute; top: 0; left: 0; width: 13px; height: 13px; border-radius: 50%; background: var(--flaeche); border: 2.5px solid var(--linie); }
  .zeitstrahl li.erledigt::before { background: var(--rot); }
  .zeitstrahl li.erledigt::after { border-color: var(--rot); background: var(--rot); }
  .zeitstrahl strong { display: block; color: var(--text); font-size: 1.05rem; }

  .gruppen { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); }
  .gruppe { display: flex; flex-direction: column; gap: .35rem; padding: 1.8rem 1.6rem; border-radius: var(--radius); background: var(--flaeche); color: var(--text); transition: transform .35s cubic-bezier(.2, .8, .2, 1); }
  .gruppe:hover { transform: scale(1.02); text-decoration: none; }
  .gruppe h3 { margin: 0; font-size: 1.4rem; }
  .gruppe p { margin: 0; color: var(--text-2); }
  .gruppe .gruppe__alter { color: var(--rot); font-weight: 600; }
  .gruppe .link-pfeil { color: var(--rot); margin-top: auto; padding-top: .8rem; }

  .zwei { display: grid; gap: clamp(2rem, 5vw, 4rem); grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); }
  .info-liste { display: grid; gap: .75rem; }
  .info-liste a { display: flex; flex-direction: column; background: var(--weiss); border-radius: var(--radius-s); padding: 1rem 1.2rem; color: var(--text); }
  .info-liste a:hover { text-decoration: none; }
  .info-liste a:hover strong { color: var(--rot); }
  .info-liste span { color: var(--text-2); font-size: .93rem; }
</style>
