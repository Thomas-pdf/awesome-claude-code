---
import { type Termin, bereichName, wochentag } from '../lib/inhalte';
interface Props { liste: Termin[]; ort?: boolean }
const { liste, ort = true } = Astro.props;
const tag = (d: Date) => d.getUTCDate();
const mon = (d: Date) => new Intl.DateTimeFormat('de-DE', { month: 'short', timeZone: 'UTC' }).format(d).replace('.', '');
---
<ol class="terminliste">
  {liste.map((t) => (
    <li class={`termin termin--${t.data.kategorie}`} data-kategorie={t.data.kategorie} data-termin-datum={t.data.datum.toISOString().slice(0, 10)}>
      <div class="termin__datum" aria-hidden="true">
        <span class="termin__wt">{wochentag(t.data.datum)}</span>
        <span class="termin__tag">{tag(t.data.datum)}</span>
        <span class="termin__mon">{mon(t.data.datum)}</span>
      </div>
      <div class="termin__info">
        <span class="sr-only">{new Intl.DateTimeFormat('de-DE', { dateStyle: 'full', timeZone: 'UTC' }).format(t.data.datum)}</span>
        <strong class="termin__titel">{t.data.titel}</strong>
        <span class="termin__meta">
          {t.data.beginn && <span>{t.data.beginn}{t.data.ende && `–${t.data.ende}`} Uhr</span>}
          {ort && t.data.ort && <span>· {t.data.ort.split(',')[0]}</span>}
          <span class="termin__kat">{bereichName(t.data.kategorie)}</span>
        </span>
        {t.body && t.body.trim() && <span class="termin__notiz">{t.body.trim()}</span>}
      </div>
    </li>
  ))}
</ol>
<script>
  // Vergangene Termine ausblenden, falls die Seite seit dem letzten Bau älter geworden ist
  const heute = new Date().toISOString().slice(0, 10);
  document.querySelectorAll<HTMLElement>('[data-termin-datum]').forEach((li) => {
    if (!location.pathname.startsWith('/termine/archiv') && li.dataset.terminDatum! < heute) li.remove();
  });
</script>
<style>
  .terminliste { list-style: none; margin: 0; padding: 0; display: grid; gap: .6rem; }
  .termin { display: grid; grid-template-columns: 58px 1fr; gap: 1rem; align-items: center; padding: .8rem 1rem; border-radius: var(--radius-s); background: var(--weiss); box-shadow: inset 0 0 0 1px var(--linie-hell); position: relative; }
  .termin::before { content: ''; position: absolute; left: 0; top: 14px; bottom: 14px; width: 3px; border-radius: 0 3px 3px 0; background: var(--c-allgemein); }
  .termin--einsatzabteilung::before { background: var(--c-einsatzabteilung); }
  .termin--jugendfeuerwehr::before { background: var(--c-jugendfeuerwehr); }
  .termin--minis::before { background: var(--c-minis); }
  .termin--verein::before { background: var(--c-verein); }
  .termin__datum { display: flex; flex-direction: column; align-items: center; line-height: 1.05; }
  .termin__wt { font-size: .72rem; color: var(--text-2); font-weight: 600; text-transform: uppercase; }
  .termin__tag { font-size: 1.7rem; font-weight: 700; letter-spacing: -.03em; }
  .termin__mon { font-size: .74rem; color: var(--rot); font-weight: 600; text-transform: uppercase; }
  .termin__titel { display: block; line-height: 1.3; font-weight: 600; }
  .termin__meta { display: flex; flex-wrap: wrap; gap: .35rem; font-size: .9rem; color: var(--text-2); }
  .termin__kat { margin-left: auto; font-size: .78rem; font-weight: 500; color: var(--text-3); }
  .termin__notiz { display: block; font-size: .9rem; color: var(--text-2); margin-top: .2rem; }
</style>
