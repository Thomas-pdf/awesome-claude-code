---
import { type Bericht, berichtUrl, bereichName, datum } from '../lib/inhalte';
interface Props { b: Bericht; gross?: boolean }
const { b, gross = false } = Astro.props;
---
<article class:list={['karte', { 'karte--gross': gross }]}>
  <div class="karte__bild">
    {b.data.bild
      ? <img src={b.data.bild} alt="" loading="lazy" decoding="async" width="640" height="400" />
      : <div class="karte__platzhalter" aria-hidden="true"><img src="/favicon.svg" alt="" width="64" height="64" /></div>}
  </div>
  <div class="karte__body">
    <div class="meta">
      <span class={`tag tag--${b.data.bereich}`}>{bereichName(b.data.bereich)}</span>
      <time datetime={b.data.date.toISOString()}>{datum(b.data.date)}</time>
    </div>
    <h3 class="karte__titel"><a href={berichtUrl(b)}>{b.data.title}</a></h3>
    {b.data.teaser && <p class="karte__text">{b.data.teaser.length > 150 ? b.data.teaser.slice(0, 150).replace(/\s\S*$/, '') + ' …' : b.data.teaser}</p>}
  </div>
</article>
<style>
  .karte__platzhalter { width: 100%; height: 100%; display: grid; place-items: center; background: var(--flaeche); }
  .karte__platzhalter img { width: 64px; height: 64px; opacity: .5; }
  .karte--gross .karte__titel { font-size: clamp(1.5rem, 2.6vw, 2.1rem); }
</style>
