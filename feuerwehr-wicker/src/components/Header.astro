---
import { NAVIGATION } from '../lib/navigation';
import { SITE } from '../lib/site';
import Logo from './Logo.astro';
const pfad = Astro.url.pathname.replace(/\/$/, '') || '/';
const aktiv = (href: string) => (href === '/' ? pfad === '/' : pfad === href || pfad.startsWith(href + '/'));
---
<div class="notruf-leiste">
  <div class="container notruf-leiste__inner">
    <a class="notruf" href="tel:112" aria-label="Notruf 112 anrufen">
      <span class="notruf__puls" aria-hidden="true"></span>
      <strong>Notruf 112</strong><span class="notruf__text"> – Feuerwehr &amp; Rettungsdienst</span>
    </a>
    <div class="notruf-leiste__rechts">
      <a href="/kontakt">{SITE.strasse}, {SITE.ortsteil}</a>
      <a href={SITE.facebook} rel="noopener" target="_blank" aria-label="Facebook (externer Link)">Facebook</a>
      <a href="/intern" class="intern-link">Mitglieder</a>
    </div>
  </div>
</div>
<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a href="/" class="marke" aria-label="Startseite – Feuerwehr Wicker">
      <Logo />
    </a>
    <button class="menue-knopf" type="button" aria-expanded="false" aria-controls="hauptnavigation" data-menu-toggle>
      <span class="menue-knopf__icon" aria-hidden="true"><span></span><span></span><span></span></span>
      <span class="menue-knopf__text">Menü</span>
    </button>
    <nav id="hauptnavigation" class="hauptnav" aria-label="Hauptnavigation" data-nav>
      <ul class="hauptnav__liste">
        {NAVIGATION.map((item) => (
          <li class={item.kinder ? 'hat-kinder' : ''}>
            {item.kinder ? (
              <>
                <button type="button" class:list={['hauptnav__link', { aktiv: item.kinder.some((k) => aktiv(k.href)) }]} aria-expanded="false" data-sub-toggle>
                  {item.label}
                  <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="2" /></svg>
                </button>
                <div class="untermenue">
                  <ul>
                    {item.kinder.map((k) => (
                      <li>
                        <a href={k.href} aria-current={aktiv(k.href) ? 'page' : undefined}>
                          <strong>{k.label}</strong>
                          {k.beschreibung && <span>{k.beschreibung}</span>}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </>
            ) : (
              <a href={item.href} class:list={['hauptnav__link', { aktiv: aktiv(item.href) }]} aria-current={aktiv(item.href) ? 'page' : undefined}>{item.label}</a>
            )}
          </li>
        ))}
        <li class="hauptnav__suche">
          <a href="/suche" class="hauptnav__link" aria-label="Suche">
            <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2.2"/><path d="m15.5 15.5 5 5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
            <span class="nur-mobil">Suche</span>
          </a>
        </li>
        <li class="hauptnav__cta"><a href="/mitmachen" class="btn btn--rot">Mitmachen</a></li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  toggle?.addEventListener('click', () => {
    const offen = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!offen));
    nav?.classList.toggle('offen', !offen);
    document.body.classList.toggle('menue-offen', !offen);
  });
  document.querySelectorAll<HTMLButtonElement>('[data-sub-toggle]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const offen = btn.getAttribute('aria-expanded') === 'true';
      document.querySelectorAll('[data-sub-toggle]').forEach((b) => b.setAttribute('aria-expanded', 'false'));
      btn.setAttribute('aria-expanded', String(!offen));
    });
  });
  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('.hat-kinder'))
      document.querySelectorAll('[data-sub-toggle]').forEach((b) => b.setAttribute('aria-expanded', 'false'));
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      document.querySelectorAll('[data-sub-toggle]').forEach((b) => b.setAttribute('aria-expanded', 'false'));
      if (nav?.classList.contains('offen')) toggle?.click();
    }
  });
  const header = document.querySelector('[data-header]');
  const onScroll = () => header?.classList.toggle('gescrollt', window.scrollY > 10);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

<style>
  .notruf-leiste { background: var(--anthrazit); color: #d6d9dc; font-size: .9rem; }
  .notruf-leiste__inner { display: flex; justify-content: space-between; align-items: center; min-height: 40px; gap: 1rem; }
  .notruf { display: inline-flex; align-items: center; gap: .55rem; color: #fff; text-decoration: none; font-weight: 600; padding: .3rem 0; }
  .notruf strong { background: var(--rot); padding: .15rem .6rem; border-radius: 6px; font-family: var(--font-head); font-size: 1.15rem; letter-spacing: .03em; }
  .notruf:hover { color: #fff; }
  .notruf:hover strong { background: var(--rot-dunkel); }
  .notruf__puls { width: 10px; height: 10px; border-radius: 50%; background: #ff3b52; box-shadow: 0 0 0 0 rgba(255, 59, 82, .7); animation: puls 2s infinite; }
  @keyframes puls { 70% { box-shadow: 0 0 0 10px rgba(255, 59, 82, 0); } 100% { box-shadow: 0 0 0 0 rgba(255, 59, 82, 0); } }
  .notruf-leiste__rechts { display: flex; gap: 1.4rem; }
  .notruf-leiste__rechts a { color: #d6d9dc; text-decoration: none; }
  .notruf-leiste__rechts a:hover { color: #fff; text-decoration: underline; }
  @media (max-width: 760px) { .notruf-leiste__rechts a:not(.intern-link), .notruf__text { display: none; } }

  .site-header { position: sticky; top: 0; z-index: 50; background: rgba(255, 255, 255, .97); backdrop-filter: saturate(1.4) blur(8px); border-bottom: 1px solid var(--linie); transition: box-shadow .2s; }
  .site-header.gescrollt { box-shadow: 0 6px 24px rgba(0, 0, 0, .08); }
  :global(body.menue-offen) { overflow: hidden; }
  .site-header__inner { display: flex; align-items: center; justify-content: space-between; min-height: 76px; gap: 1rem; }
  .marke { text-decoration: none; color: inherit; display: flex; }

  .hauptnav__liste { list-style: none; margin: 0; padding: 0; display: flex; align-items: center; gap: .15rem; }
  .hauptnav__link {
    display: inline-flex; align-items: center; gap: .35rem; padding: .6rem .8rem; border-radius: 8px; font: 600 1.02rem var(--font-body);
    color: var(--text); text-decoration: none; background: none; border: 0; cursor: pointer;
  }
  .hauptnav__link:hover, .hauptnav__link[aria-expanded='true'] { background: var(--flaeche); color: var(--rot); }
  .hauptnav__link.aktiv { color: var(--rot); box-shadow: inset 0 -3px 0 var(--rot); border-radius: 0; }
  .hauptnav__link svg { transition: transform .2s; }
  .hauptnav__link[aria-expanded='true'] svg { transform: rotate(180deg); }
  .hat-kinder { position: relative; }
  .untermenue {
    position: absolute; top: calc(100% + 10px); left: 50%; transform: translateX(-50%); min-width: 320px; background: #fff;
    border: 1px solid var(--linie); border-radius: var(--radius); box-shadow: var(--schatten-hover); padding: .5rem; display: none;
  }
  [aria-expanded='true'] + .untermenue { display: block; }
  .untermenue ul { list-style: none; margin: 0; padding: 0; }
  .untermenue a { display: block; padding: .6rem .8rem; border-radius: 8px; text-decoration: none; color: var(--text); }
  .untermenue a:hover, .untermenue a[aria-current='page'] { background: var(--rot-hell); }
  .untermenue strong { display: block; font-weight: 700; }
  .untermenue span { display: block; font-size: .88rem; color: var(--text-2); }
  .hauptnav__cta { margin-left: .5rem; }
  .nur-mobil { display: none; }

  .menue-knopf { display: none; align-items: center; gap: .5rem; background: none; border: 1.5px solid var(--linie); border-radius: 10px; padding: .55rem .8rem; font: 700 1rem var(--font-body); color: var(--text); cursor: pointer; }
  .menue-knopf__icon { display: grid; gap: 4px; width: 20px; }
  .menue-knopf__icon span { height: 2px; background: currentColor; border-radius: 2px; transition: .2s; }
  .menue-knopf[aria-expanded='true'] .menue-knopf__icon span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .menue-knopf[aria-expanded='true'] .menue-knopf__icon span:nth-child(2) { opacity: 0; }
  .menue-knopf[aria-expanded='true'] .menue-knopf__icon span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  @media (max-width: 1100px) {
    .menue-knopf { display: inline-flex; }
    .hauptnav { position: absolute; top: 100%; left: 0; right: 0; height: calc(100dvh - 76px); background: #fff; overflow-y: auto; padding: 1rem 1rem 3rem; display: none; border-top: 1px solid var(--linie); }
    .hauptnav.offen { display: block; }
    .hauptnav__liste { flex-direction: column; align-items: stretch; gap: 0; }
    .hauptnav__liste > li { border-bottom: 1px solid var(--linie); }
    .hauptnav__link { width: 100%; justify-content: space-between; padding: 1rem .5rem; font-size: 1.15rem; }
    .hauptnav__link.aktiv { box-shadow: inset 4px 0 0 var(--rot); padding-left: 1rem; }
    .untermenue { position: static; transform: none; box-shadow: none; border: 0; min-width: 0; padding: 0 0 .8rem .5rem; }
    .hauptnav__cta { margin: 1.2rem 0 0; border: 0 !important; }
    .hauptnav__cta .btn { width: 100%; justify-content: center; padding: 1rem; font-size: 1.1rem; }
    .nur-mobil { display: inline; }
    .hauptnav__suche .hauptnav__link { justify-content: flex-start; gap: .7rem; }
  }
</style>
