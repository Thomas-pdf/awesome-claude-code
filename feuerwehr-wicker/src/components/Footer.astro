---
import { SITE, UEBUNGSZEITEN } from '../lib/site';
import { FOOTER_LINKS, NAVIGATION } from '../lib/navigation';
import Logo from './Logo.astro';
const jahr = new Date().getFullYear();
const ueber = NAVIGATION.find((n) => n.kinder && n.label === 'Über uns')?.kinder ?? [];
---
<section class="notruf-karte-wrap" aria-label="Notruf">
  <div class="container">
    <div class="notruf-karte">
      <div>
        <p class="notruf-karte__label">Im Notfall</p>
        <a class="notruf-karte__nummer" href="tel:112">112</a>
      </div>
      <p class="notruf-karte__text">Feuer, Unfall, medizinischer Notfall: Wählen Sie die <strong>112</strong>. Kostenlos, ohne Vorwahl, aus jedem Netz. Die Leitstelle alarmiert die Feuerwehr. Polizei: <a href="tel:110">110</a>.</p>
    </div>
  </div>
</section>
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-spalte footer-spalte--marke">
        <Logo hoehe={26} zusatz={false} />
        <p>Freiwillige Feuerwehr Flörsheim-Wicker<br />{SITE.strasse}, {SITE.plz} {SITE.ort}-{SITE.ortsteil}</p>
        <p>Tel. <a href={`tel:${SITE.telefonLink}`}>{SITE.telefon}</a> (keine Notrufe)<br /><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
      </div>
      <nav class="footer-spalte" aria-label="Über uns">
        <h2>Über uns</h2>
        <ul>{ueber.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </nav>
      <div class="footer-spalte">
        <h2>Übungszeiten</h2>
        <ul>{UEBUNGSZEITEN.map((u) => <li><a href={u.link}>{u.gruppe}</a><span>{u.zeit}</span></li>)}</ul>
      </div>
      <nav class="footer-spalte" aria-label="Service">
        <h2>Service</h2>
        <ul>
          <li><a href="/aktuelles">Aktuelles</a></li>
          <li><a href="/einsaetze">Einsätze</a></li>
          <li><a href="/termine">Termine</a></li>
          <li><a href="/termine.ics">Kalender abonnieren</a></li>
          <li><a href="/buergerinfo">Bürgerinfo</a></li>
          <li><a href={SITE.facebook} rel="noopener" target="_blank">Facebook</a></li>
        </ul>
      </nav>
    </div>
    <div class="footer-unten">
      <span>Copyright © {jahr} {SITE.verein}. Keine Cookies, keine Tracker.</span>
      <ul>{FOOTER_LINKS.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </div>
  </div>
</footer>
<style>
  .notruf-karte-wrap { padding-block: 0 3rem; background: var(--weiss); }
  .notruf-karte { display: flex; align-items: center; gap: 1.5rem 2.5rem; flex-wrap: wrap; background: var(--rot-hell); border-radius: var(--radius); padding: 1.6rem 2rem; }
  .notruf-karte__label { margin: 0; font-weight: 600; color: var(--rot-dunkel); font-size: .95rem; }
  .notruf-karte__nummer { display: block; font-size: 3.6rem; font-weight: 800; letter-spacing: -.04em; line-height: 1; color: var(--rot); }
  .notruf-karte__nummer:hover { text-decoration: none; color: var(--rot-dunkel); }
  .notruf-karte__text { margin: 0; max-width: 60ch; color: var(--text); }
  .site-footer { background: var(--flaeche); color: var(--text-2); font-size: .8rem; line-height: 1.5; margin-top: auto; }
  .site-footer a { color: var(--text-2); }
  .site-footer a:hover { color: var(--text); }
  .footer-grid { display: grid; gap: 2rem; padding-block: 2.6rem 1.8rem; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); border-bottom: 1px solid var(--linie); }
  .footer-spalte h2 { font-size: .8rem; font-weight: 600; color: var(--text); margin: 0 0 .6rem; letter-spacing: -.005em; }
  .footer-spalte ul { list-style: none; padding: 0; margin: 0; display: grid; gap: .45rem; }
  .footer-spalte li span { display: block; color: var(--text-3); }
  .footer-spalte--marke p { margin: 1rem 0 0; }
  .footer-unten { display: flex; justify-content: space-between; gap: .8rem 2rem; padding-block: 1.1rem 1.6rem; flex-wrap: wrap; }
  .footer-unten ul { list-style: none; display: flex; flex-wrap: wrap; gap: .3rem 1.1rem; margin: 0; padding: 0; }
</style>
