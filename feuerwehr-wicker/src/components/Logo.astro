---
// Offizielles Logo „Feuerwehren Stadt Flörsheim am Main“ (public/logo-feuerwehren-floersheim.*)
interface Props { hoehe?: number; zusatz?: boolean }
const { hoehe = 34, zusatz = true } = Astro.props;
const breite = Math.round(hoehe * (2265 / 434));
---
<span class="logo">
  <img src="/logo-feuerwehren-floersheim.webp" alt="Feuerwehren Stadt Flörsheim am Main" width={breite} height={hoehe} style={`height:${hoehe}px`} />
  {zusatz && <span class="logo__zusatz">Freiwillige Feuerwehr<br />Wicker</span>}
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: .85rem; }
  .logo img { width: auto; max-width: 100%; }
  .logo__zusatz { font-size: .74rem; line-height: 1.15; font-weight: 600; color: var(--text-2); letter-spacing: 0; padding-left: .85rem; border-left: 1px solid var(--linie); }
  @media (max-width: 520px) { .logo__zusatz { display: none; } }
</style>
